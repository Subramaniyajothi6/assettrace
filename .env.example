# Supabase → Project Settings → Database → Connection string
# App connection. On Vercel use the transaction pooler (port 6543, ?pgbouncer=true).
# For local development the session pooler (port 5432) is much faster; you can use DIRECT_URL here.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (port 5432) for migrations:
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
# Needed for `next start` outside Vercel (Vercel sets it automatically)
AUTH_TRUST_HOST="true"

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""   # server only, never prefix with NEXT_PUBLIC_
SUPABASE_BUCKET="asset-files"  # create as PRIVATE bucket

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEMO_MODE="true"   # shows demo logins on /login

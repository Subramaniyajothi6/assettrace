// AssetTrace — Prisma schema (PostgreSQL / Supabase)
// See docs/ARCHITECTURE.md for lifecycle rules.
// After first migration, add the partial unique index:
//   CREATE UNIQUE INDEX one_active_assignment ON "Assignment"("assetId") WHERE "isActive" = true;

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  EMPLOYEE
  MANAGER
  ADMIN
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  UNDER_MAINTENANCE
  RESERVED
  LOST
  DAMAGED
  RETURNED
  RETIRED
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum HandoverStatus {
  PENDING
  CONFIRMED
  DISPUTED
}

enum AssignmentEndReason {
  RETURNED
  TRANSFERRED
  LOST
  RETIRED
}

enum TransferStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum IssueCategory {
  HARDWARE
  SOFTWARE
  PHYSICAL_DAMAGE
  PERFORMANCE
  BATTERY
  NETWORK
  OTHER
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  REPORTED
  UNDER_REVIEW
  MAINTENANCE
  RESOLVED
  CLOSED
}

enum MaintenanceType {
  REPAIR
  PREVENTIVE
  UPGRADE
  WARRANTY_CLAIM
  OTHER
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReturnStatus {
  REQUESTED
  RECEIVED
  INSPECTED
  REJECTED
  CANCELLED
}

enum InspectionResult {
  GOOD
  MINOR_REPAIR_REQUIRED
  MAJOR_REPAIR_REQUIRED
  DAMAGED
  RETIRE
}

enum DisposalMethod {
  RECYCLED
  SOLD
  DONATED
  DESTROYED
  RETURNED_TO_VENDOR
  OTHER
}

enum RequestType {
  ISSUE
  REPLACEMENT
  RETURN
  NEW_ASSET
}

enum RequestStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum HistoryEvent {
  REGISTERED
  UPDATED
  STATUS_CHANGED
  ASSIGNED
  HANDOVER_CONFIRMED
  HANDOVER_DISPUTED
  TRANSFER_REQUESTED
  TRANSFER_REJECTED
  TRANSFERRED
  ISSUE_REPORTED
  ISSUE_UPDATED
  MAINTENANCE_STARTED
  MAINTENANCE_IN_PROGRESS
  MAINTENANCE_COMPLETED
  RETURN_REQUESTED
  RETURNED
  INSPECTED
  MARKED_LOST
  RETIRED
}

enum NotificationType {
  ASSET_ASSIGNED
  HANDOVER_CONFIRMED
  HANDOVER_DISPUTED
  TRANSFER_REQUESTED
  TRANSFER_COMPLETED
  RETURN_REQUESTED
  MAINTENANCE_COMPLETED
  WARRANTY_EXPIRING
  ISSUE_STATUS_UPDATED
  REQUEST_UPDATED
  GENERAL
}

// ───────────────────────── Identity ─────────────────────────

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  name               String
  role               Role      @default(EMPLOYEE)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  employee           Employee?
  managedDepartments Department[] @relation("DepartmentManagers")

  assetsCreated      Asset[]             @relation("AssetCreatedBy")
  assignmentsMade    Assignment[]        @relation("AssignmentAssignedBy")
  transfersRequested AssetTransfer[]     @relation("TransferRequestedBy")
  transfersReviewed  AssetTransfer[]     @relation("TransferReviewedBy")
  maintenanceCreated MaintenanceRecord[] @relation("MaintenanceCreatedBy")
  returnsReceived    AssetReturn[]       @relation("ReturnReceivedBy")
  inspections        AssetInspection[]   @relation("InspectionBy")
  retirements        AssetRetirement[]   @relation("RetirementAuthorizedBy")
  requestsHandled    EmployeeRequest[]   @relation("RequestHandledBy")
  issuesHandled      AssetIssue[]        @relation("IssueHandledBy")
  historyEvents      AssetHistory[]      @relation("HistoryActor")
  notifications      Notification[]
}

model Employee {
  id           String   @id @default(cuid())
  employeeCode String   @unique // EMP-0001
  name         String
  email        String   @unique
  phone        String?
  designation  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId       String?    @unique
  user         User?      @relation(fields: [userId], references: [id])
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  locationId   String?
  location     Location?  @relation(fields: [locationId], references: [id])

  currentAssets Asset[]           @relation("AssetHolder")
  assignments   Assignment[]
  transfersFrom AssetTransfer[]   @relation("TransferFromEmployee")
  transfersTo   AssetTransfer[]   @relation("TransferToEmployee")
  issues        AssetIssue[]
  returns       AssetReturn[]
  requests      EmployeeRequest[]

  @@index([departmentId])
}

// ───────────────────────── Master data ─────────────────────────

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  managers      User[]          @relation("DepartmentManagers")
  employees     Employee[]
  assets        Asset[]
  assignments   Assignment[]
  transfersFrom AssetTransfer[] @relation("TransferFromDepartment")
  transfersTo   AssetTransfer[] @relation("TransferToDepartment")
}

model Location {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  employees     Employee[]
  assets        Asset[]
  assignments   Assignment[]
  transfersFrom AssetTransfer[] @relation("TransferFromLocation")
  transfersTo   AssetTransfer[] @relation("TransferToLocation")
}

model AssetCategory {
  id          String   @id @default(cuid())
  name        String   @unique // Laptop
  code        String   @unique // LAP  -> asset tag AST-LAP-0001
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  assets Asset[]
}

model Vendor {
  id          String   @id @default(cuid())
  name        String   @unique
  contactName String?
  email       String?
  phone       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  assets Asset[]
}

// ───────────────────────── Assets ─────────────────────────

model Asset {
  id            String         @id @default(cuid())
  assetTag      String         @unique // AST-LAP-0001 (the "Asset ID")
  name          String
  assetType     String?
  brand         String?
  model         String?
  serialNumber  String?        @unique // nullable unique: many NULLs allowed
  purchaseDate  DateTime?
  purchaseCost  Decimal?       @db.Decimal(12, 2)
  warrantyStart DateTime?
  warrantyEnd   DateTime?
  status        AssetStatus    @default(AVAILABLE)
  condition     AssetCondition @default(NEW)
  notes         String?
  photoPath     String? // Supabase Storage key, never a public URL
  qrToken       String         @unique @default(cuid())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  categoryId      String
  category        AssetCategory @relation(fields: [categoryId], references: [id])
  vendorId        String?
  vendor          Vendor?       @relation(fields: [vendorId], references: [id])
  locationId      String?
  location        Location?     @relation(fields: [locationId], references: [id])
  departmentId    String?
  department      Department?   @relation(fields: [departmentId], references: [id])
  currentHolderId String?
  currentHolder   Employee?     @relation("AssetHolder", fields: [currentHolderId], references: [id])
  createdById     String
  createdBy       User          @relation("AssetCreatedBy", fields: [createdById], references: [id])

  assignments Assignment[]
  transfers   AssetTransfer[]
  issues      AssetIssue[]
  maintenance MaintenanceRecord[]
  returns     AssetReturn[]
  inspections AssetInspection[]
  retirement  AssetRetirement?
  history     AssetHistory[]
  requests    EmployeeRequest[]

  @@index([status])
  @@index([categoryId])
  @@index([departmentId])
  @@index([locationId])
  @@index([warrantyEnd])
  @@index([currentHolderId])
}

// Assignment + digital handover live together (one handover per assignment)
model Assignment {
  id                    String         @id @default(cuid())
  assignedAt            DateTime       @default(now())
  expectedReturnDate    DateTime?
  conditionAtAssignment AssetCondition
  accessories           String[]
  remarks               String?

  handoverStatus        HandoverStatus @default(PENDING)
  handoverDate          DateTime?
  handoverConfirmedAt   DateTime?
  handoverNote          String?
  handoverSignaturePath String? // Supabase Storage key of the signed PNG

  isActive  Boolean              @default(true)
  endedAt   DateTime?
  endReason AssignmentEndReason?

  assetId      String
  asset        Asset       @relation(fields: [assetId], references: [id])
  employeeId   String
  employee     Employee    @relation(fields: [employeeId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  locationId   String?
  location     Location?   @relation(fields: [locationId], references: [id])
  assignedById String
  assignedBy   User        @relation("AssignmentAssignedBy", fields: [assignedById], references: [id])

  createdByTransfer AssetTransfer? @relation("TransferNewAssignment")
  returns           AssetReturn[]

  @@index([assetId, isActive])
  @@index([employeeId, isActive])
}

model AssetTransfer {
  id            String         @id @default(cuid())
  transferNo    String         @unique // TRF-0001
  reason        String
  status        TransferStatus @default(REQUESTED)
  reviewRemarks String?
  requestedAt   DateTime       @default(now())
  reviewedAt    DateTime?
  completedAt   DateTime?

  assetId          String
  asset            Asset       @relation(fields: [assetId], references: [id])
  fromEmployeeId   String?
  fromEmployee     Employee?   @relation("TransferFromEmployee", fields: [fromEmployeeId], references: [id])
  toEmployeeId     String
  toEmployee       Employee    @relation("TransferToEmployee", fields: [toEmployeeId], references: [id])
  fromDepartmentId String?
  fromDepartment   Department? @relation("TransferFromDepartment", fields: [fromDepartmentId], references: [id])
  toDepartmentId   String?
  toDepartment     Department? @relation("TransferToDepartment", fields: [toDepartmentId], references: [id])
  fromLocationId   String?
  fromLocation     Location?   @relation("TransferFromLocation", fields: [fromLocationId], references: [id])
  toLocationId     String?
  toLocation       Location?   @relation("TransferToLocation", fields: [toLocationId], references: [id])
  requestedById    String
  requestedBy      User        @relation("TransferRequestedBy", fields: [requestedById], references: [id])
  reviewedById     String?
  reviewedBy       User?       @relation("TransferReviewedBy", fields: [reviewedById], references: [id])
  newAssignmentId  String?     @unique
  newAssignment    Assignment? @relation("TransferNewAssignment", fields: [newAssignmentId], references: [id])

  @@index([assetId])
  @@index([status])
}

model AssetIssue {
  id          String        @id @default(cuid())
  issueNo     String        @unique // ISS-0001
  category    IssueCategory
  title       String
  description String
  severity    Severity
  photoPath   String?
  status      IssueStatus   @default(REPORTED)
  resolution  String?
  reportedAt  DateTime      @default(now())
  resolvedAt  DateTime?

  assetId      String
  asset        Asset    @relation(fields: [assetId], references: [id])
  reportedById String
  reportedBy   Employee @relation(fields: [reportedById], references: [id])
  handledById  String?
  handledBy    User?    @relation("IssueHandledBy", fields: [handledById], references: [id])

  maintenance MaintenanceRecord[]
  request     EmployeeRequest?

  @@index([assetId])
  @@index([status])
}

model MaintenanceRecord {
  id                 String            @id @default(cuid())
  maintenanceNo      String            @unique // MNT-0001
  problem            String
  type               MaintenanceType
  serviceProvider    String?
  serviceDate        DateTime
  cost               Decimal           @default(0) @db.Decimal(12, 2)
  partsReplaced      String?
  technicianNotes    String?
  warrantyCovered    Boolean           @default(false)
  expectedCompletion DateTime?
  actualCompletion   DateTime?
  status             MaintenanceStatus @default(SCHEDULED)
  statusBefore       AssetStatus? // restore target when completed
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  assetId     String
  asset       Asset       @relation(fields: [assetId], references: [id])
  issueId     String?
  issue       AssetIssue? @relation(fields: [issueId], references: [id])
  createdById String
  createdBy   User        @relation("MaintenanceCreatedBy", fields: [createdById], references: [id])

  @@index([assetId])
  @@index([status])
}

model AssetReturn {
  id                 String          @id @default(cuid())
  returnNo           String          @unique // RET-0001
  status             ReturnStatus    @default(REQUESTED)
  reason             String?
  requestedAt        DateTime        @default(now())
  receivedAt         DateTime?
  condition          AssetCondition?
  missingAccessories String[]
  damage             String?
  remarks            String?
  photoPaths         String[]

  assetId      String
  asset        Asset      @relation(fields: [assetId], references: [id])
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  returnedById String
  returnedBy   Employee   @relation(fields: [returnedById], references: [id])
  receivedById String?
  receivedBy   User?      @relation("ReturnReceivedBy", fields: [receivedById], references: [id])

  inspection AssetInspection?
  request    EmployeeRequest?

  @@index([assetId])
  @@index([status])
}

model AssetInspection {
  id                 String           @id @default(cuid())
  physicalCondition  AssetCondition
  screenCondition    String?
  keyboardCondition  String?
  batteryCondition   String?
  chargerAvailable   Boolean          @default(true)
  accessoriesPresent String[]
  isFunctional       Boolean          @default(true)
  visibleDamage      String?
  missingComponents  String?
  remarks            String?
  result             InspectionResult
  inspectedAt        DateTime         @default(now())

  assetId       String
  asset         Asset        @relation(fields: [assetId], references: [id])
  returnId      String?      @unique
  assetReturn   AssetReturn? @relation(fields: [returnId], references: [id])
  inspectedById String
  inspectedBy   User         @relation("InspectionBy", fields: [inspectedById], references: [id])

  @@index([assetId])
}

model AssetRetirement {
  id             String         @id @default(cuid())
  retirementDate DateTime
  reason         String
  finalCondition AssetCondition
  disposalMethod DisposalMethod
  remarks        String?
  createdAt      DateTime       @default(now())

  assetId        String @unique
  asset          Asset  @relation(fields: [assetId], references: [id])
  authorizedById String
  authorizedBy   User   @relation("RetirementAuthorizedBy", fields: [authorizedById], references: [id])
}

// Append-only timeline. Never update or delete rows.
model AssetHistory {
  id          String       @id @default(cuid())
  event       HistoryEvent
  fromStatus  AssetStatus?
  toStatus    AssetStatus?
  description String
  metadata    Json?
  createdAt   DateTime     @default(now())

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])
  actorId String
  actor   User   @relation("HistoryActor", fields: [actorId], references: [id])

  @@index([assetId, createdAt])
}

model EmployeeRequest {
  id             String        @id @default(cuid())
  requestNo      String        @unique // REQ-0001
  type           RequestType
  title          String
  description    String
  priority       Priority      @default(MEDIUM)
  status         RequestStatus @default(PENDING)
  managerRemarks String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  resolvedAt     DateTime?

  employeeId  String
  employee    Employee     @relation(fields: [employeeId], references: [id])
  assetId     String?
  asset       Asset?       @relation(fields: [assetId], references: [id])
  handledById String?
  handledBy   User?        @relation("RequestHandledBy", fields: [handledById], references: [id])
  issueId     String?      @unique
  issue       AssetIssue?  @relation(fields: [issueId], references: [id])
  returnId    String?      @unique
  assetReturn AssetReturn? @relation(fields: [returnId], references: [id])

  @@index([employeeId])
  @@index([status])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

// ───────────────────────── System ─────────────────────────

// Human-readable running numbers (AST-LAP, REQ, TRF, ISS, MNT, RET, EMP)
model Sequence {
  name  String @id
  value Int    @default(0)
}

// Admin "System settings": warrantyAlertDays, orgName, assetTagPrefix, ...
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
